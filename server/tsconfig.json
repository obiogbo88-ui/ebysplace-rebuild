{
  "extends": "../tsconfig.json",
  "include": [
    "./**/*.ts",
    "../shared/**/*.ts",
    "../drizzle/**/*.ts"
  ],
  "exclude": [
    "../node_modules",
    "../dist",
    "../public",
    "../api",
    "**/*.test.ts"
  ],
  "compilerOptions": {
    "noEmit": false,
    "outDir": "../dist/server-compiled",
    "rootDir": "..",
    "declaration": false,
    "sourceMap": false,
    "incremental": false,
    "tsBuildInfoFile": "../node_modules/typescript/server-tsbuildinfo",
    "allowImportingTsExtensions": false,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "noEmitOnError": false
  }
}
