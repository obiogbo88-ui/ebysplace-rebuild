{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "ebysplace.com"
        }
      ],
      "destination": "https://www.ebysplace.com/$1",
      "permanent": true
    },
    {
      "source": "/booking%E2%81%A0",
      "destination": "/booking",
      "permanent": true
    },
    {
      "source": "/booking⁠",
      "destination": "/booking",
      "permanent": true
    },
    {
      "source": "/booking/",
      "destination": "/booking",
      "permanent": true
    },
    {
      "source": "/booking.html",
      "destination": "/booking",
      "permanent": true
    },
    {
      "source": "/ts_footer_block",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/footer-6",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/the-best-items-",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/the-best-items",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/product/starter-locs",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/product/beads-accessories",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/product/:slug*",
      "destination": "/shop/:slug*",
      "permanent": true
    },
    {
      "source": "/product-category/:path*",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/category/:path*",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/service/:path*",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/book",
      "destination": "/booking",
      "permanent": true
    },
    {
      "source": "/book-now",
      "destination": "/booking",
      "permanent": true
    },
    {
      "source": "/bookings",
      "destination": "/booking",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
