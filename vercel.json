{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{public/**,node_modules/@ffmpeg-installer/**,node_modules/.pnpm/@ffmpeg-installer+*/node_modules/@ffmpeg-installer/**}",
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/social-prepare",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/social-publish-am",
      "schedule": "0 7,8 * * *"
    },
    {
      "path": "/api/cron/social-publish-md",
      "schedule": "30 11,12 * * *"
    },
    {
      "path": "/api/cron/social-publish-pm",
      "schedule": "0 19,20 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/booking/",
      "destination": "/booking",
      "permanent": true
    },
    {
      "source": "/book",
      "destination": "/booking",
      "permanent": true
    },
    {
      "source": "/book-now",
      "destination": "/booking",
      "permanent": true
    },
    {
      "source": "/bookings",
      "destination": "/booking",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/booking",
      "destination": "/index.html"
    },
    {
      "source": "/booking/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/shop/:slug",
      "destination": "/api/index?__share=product&__slug=:slug"
    },
    {
      "source": "/services",
      "has": [
        {
          "type": "query",
          "key": "style",
          "value": "(?<style>[a-z0-9-]+)"
        }
      ],
      "destination": "/api/index?__share=service&__slug=:style"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
